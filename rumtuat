    ORIGINAL_BALL[k] = Object.assign({}, BALL_ENGINE_DEFAULT, {
      radius: d0.radius != null ? d0.radius : BALL_ENGINE_DEFAULT.radius,
      invMass: d0.invMass != null ? d0.invMass : BALL_ENGINE_DEFAULT.invMass,
