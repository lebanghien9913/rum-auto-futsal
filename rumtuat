  if ((e.boxes[type] || 0) < qty || qty <= 0) return tell(p.id, `❌ Không đủ rương ${type}.`, C.err);
  e.boxes[type] -= qty;
  tell(p.id, `📦 Mở ${qty}x rương ${type.toUpperCase()}:`, C.super, "bold");
  for (let i = 0; i < qty; i++) {
    const r = rollBox(type);
