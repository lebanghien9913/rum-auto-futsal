// Vật lý chuẩn của người chơi & bóng (dùng cả cho map lẫn hệ thống buff)
const BASE_PLAYER = { radius: 15, bCoef: 0.5, invMass: 0.5, damping: 0.96 };
const DEFAULT_BALL_RADIUS = 8;   // 👈 BÓNG NHỎ MẶC ĐỊNH (áp dụng cho mọi map, kể cả map bạn tự dán)
