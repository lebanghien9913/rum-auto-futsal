// Kích thước nửa sân (tính từ tâm). Toàn bộ số liệu khác được suy ra ở deriveDims().
const DIMS = {
  "1v1": { size: 1, halfW: 420, halfH: 200, goalHalf: 70,  kickoffR: 62, netDepth: 38 },
  "2v2": { size: 2, halfW: 620, halfH: 280, goalHalf: 100, kickoffR: 88, netDepth: 46 },
};
// Chế độ thi đấu → kích thước sân + luật
const MODE_INFO = {
  "1v1":      { size: 1, dim: "1v1", barrier: true,  score: 3, time: 3, label: "1v1" },
  "2v2":      { size: 2, dim: "2v2", barrier: true,  score: 5, time: 5, label: "2v2" },
  "practice": { size: 0, dim: "2v2", barrier: false, score: 0, time: 0, label: "Luyện tập" },
};

function makeSpawns(sign, n, sx, halfH) {
  if (n <= 1) return [[sign * sx, 0]];
  const span = Math.min(halfH * 0.75, halfH * 0.3 * (n - 1));
  const pts = [];
  for (let i = 0; i < n; i++) pts.push([sign * sx, Math.round(-span + i * (2 * span / (n - 1)))]);
  return pts;
}

function deriveDims(m, spawnCount) {
  const d = {
    W: m.halfW, H: m.halfH, g: m.goalHalf, cr: m.kickoffR, D: m.netDepth,
    postR: 8,
    outerW: m.halfW + 90,          // biên ngoài cùng (người + bóng không thể vượt)
    outerH: m.halfH + 70,
    sx: Math.round(m.halfW * 0.5), // khoảng cách điểm xuất phát tới tâm
  };
  d.redSpawn = makeSpawns(-1, spawnCount, d.sx, d.H);
  d.blueSpawn = makeSpawns(1, spawnCount, d.sx, d.H);
  // ── kiểm tra hợp lệ (chống lỗi bản đồ)
  const errs = [];
  if (!(d.g > 30 && d.g < d.H - 20)) errs.push("khung thành không hợp lệ");
  if (d.cr + BASE_PLAYER.radius * 2 > d.sx) errs.push("vòng giao bóng chạm điểm xuất phát");
  if (d.D + 20 > d.outerW - d.W) errs.push("lưới vượt biên ngoài");
  if (d.cr >= d.H - 10) errs.push("vòng giao bóng quá lớn");
  if (errs.length) throw new Error("Bản đồ lỗi: " + errs.join("; "));
  return d;
}

function buildStadium(modeKey) {
  const mi = MODE_INFO[modeKey], m = DIMS[mi.dim];
  const d = deriveDims(m, mi.size === 0 ? 8 : mi.size);
  const vertexes = [], segments = [], planes = [], goals = [], discs = [];
  const V = (x, y, o) => vertexes.push(Object.assign({ x, y }, o || {})) - 1;
  const S = (a, b, o) => segments.push(Object.assign({ v0: a, v1: b }, o || {}));

  /* --- Tường chỉ va chạm với bóng (biên sân + đầu khung thành) --- */
  const BV = { bCoef: 0.5, cMask: ["ball"] };
  const BW = { vis: false, bCoef: 0.5, cMask: ["ball"] };
  const c00 = V(-d.W, -d.H, BV), c01 = V(d.W, -d.H, BV);
  const c11 = V(d.W, d.H, BV), c10 = V(-d.W, d.H, BV);
  const gl0 = V(-d.W, -d.g, BV), gl1 = V(-d.W, d.g, BV);
  const gr0 = V(d.W, -d.g, BV), gr1 = V(d.W, d.g, BV);
  S(c00, c01, BW); S(c10, c11, BW);
  S(c00, gl0, BW); S(gl1, c10, BW);
  S(c01, gr0, BW); S(gr1, c11, BW);

  /* --- Lưới quanh cầu môn (bóng dừng lại, người không vào được) --- */
  const NV = { bCoef: 0.1, cMask: ["ball"] };
  const NET = (col) => ({ vis: true, bCoef: 0.1, cMask: ["ball"], color: col });
  const nl0 = V(-d.W - d.D, -d.g, NV), nl1 = V(-d.W - d.D, d.g, NV);
  S(gl0, nl0, NET("FFCCCC")); S(nl0, nl1, NET("FFCCCC")); S(nl1, gl1, NET("FFCCCC"));
  const nr0 = V(d.W + d.D, -d.g, NV), nr1 = V(d.W + d.D, d.g, NV);
  S(gr0, nr0, NET("CCCCFF")); S(nr0, nr1, NET("CCCCFF")); S(nr1, gr1, NET("CCCCFF"));
  // Chặn người chơi chui vào lưới (chống kẹt / chống bug đứng trong gôn)
  S(gl0, gl1, { vis: false, bCoef: 0.2, cMask: ["red", "blue"] });
  S(gr0, gr1, { vis: false, bCoef: 0.2, cMask: ["red", "blue"] });

  /* --- Rào chắn giao bóng (kickoff barrier) --- */
  if (mi.barrier) {
    const KO = ["redKO", "blueKO"];
    const KV = { bCoef: 0.1, cMask: ["red", "blue"], cGroup: KO };
    const KS = { vis: false, bCoef: 0.1, cMask: ["red", "blue"], cGroup: KO };
    const t = V(0, -d.outerH, KV), a = V(0, -d.cr, KV), b = V(0, d.cr, KV), u = V(0, d.outerH, KV);
    S(t, a, KS); S(b, u, KS);       // vạch giữa sân kéo tới biên ngoài
    // Vòng tròn giữa sân: mỗi nhóm KO có 1 vòng tròn đầy đủ (2 nửa cung)
    for (const grp of ["redKO", "blueKO"])
      for (const cv of [180, -180])
        S(a, b, { curve: cv, vis: false, bCoef: 0.1, cMask: ["red", "blue"], cGroup: [grp] });
  }

  /* --- Mặt phẳng biên (backup chống bóng/người thoát khỏi map) --- */
  planes.push(
    // Người + bóng: biên ngoài cùng
    { normal: [0, 1],  dist: -d.outerH, bCoef: 0.1, cMask: ["all"] },
    { normal: [0, -1], dist: -d.outerH, bCoef: 0.1, cMask: ["all"] },
    { normal: [1, 0],  dist: -d.outerW, bCoef: 0.1, cMask: ["all"] },
    { normal: [-1, 0], dist: -d.outerW, bCoef: 0.1, cMask: ["all"] },
    // Chỉ bóng: sát đường biên & đáy lưới
    { normal: [0, 1],  dist: -d.H, bCoef: 0.5, cMask: ["ball"] },
    { normal: [0, -1], dist: -d.H, bCoef: 0.5, cMask: ["ball"] },
    { normal: [1, 0],  dist: -(d.W + d.D), bCoef: 0.1, cMask: ["ball"] },
    { normal: [-1, 0], dist: -(d.W + d.D), bCoef: 0.1, cMask: ["ball"] }
  );

  /* --- Khung thành --- */
  goals.push(
    { p0: [-d.W, -d.g], p1: [-d.W, d.g], team: "red" },
    { p0: [d.W, -d.g], p1: [d.W, d.g], team: "blue" }
  );

  /* --- Bóng (disc 0) + cột gôn --- */
  discs.push(Object.assign({ pos: [0, 0], color: "FFFFFF", cGroup: ["ball", "kick", "score"] }, BASE_BALL));
  for (const sx of [-1, 1]) for (const sy of [-1, 1])
    discs.push({ pos: [sx * d.W, sy * d.g], radius: d.postR, invMass: 0, bCoef: 0.6,
      color: sx < 0 ? "FFCCCC" : "CCCCFF" });

  return {
    name: "VN " + mi.label,
    width: d.outerW, height: d.outerH,
    spawnDistance: d.sx,
    redSpawnPoints: d.redSpawn, blueSpawnPoints: d.blueSpawn,
    bg: { type: "grass", width: d.W, height: d.H, kickOffRadius: d.cr, cornerRadius: 0 },
    cameraFollow: "ball", canBeStored: false,
    vertexes, segments, planes, goals, discs,
    playerPhysics: Object.assign({
      acceleration: 0.1, kickingAcceleration: 0.07, kickingDamping: 0.96, kickStrength: 5,
    }, BASE_PLAYER),
    ballPhysics: "disc0",
  };
}

