const SLOT_SYMBOLS = ["🍒", "🍋", "🍇", "🔔", "⭐", "💎"];
function gameSlot(p, amount) {
  if (!isPosInt(amount)) return tell(p.id, "💡 !slot <xu>", C.warn);
  const e = econ(p.auth, p.name); if (e.coins < amount) return tell(p.id, "❌ Không đủ xu.", C.err);
  e.coins -= amount;
  const reels = [0, 0, 0].map(() => SLOT_SYMBOLS[Math.floor(Math.random() * SLOT_SYMBOLS.length)]);
  tell(p.id, `🎰 [SLOT] ${reels.join(" | ")}`, C.info, "bold");
  const uniq = new Set(reels).size, mult = uniq === 1 ? 10 : uniq === 2 ? 2 : 0;
  if (mult > 0) { const pay = Math.floor(amount * mult); e.coins += pay; tell(p.id, `🎉 Trúng! +${pay.toLocaleString()} xu`, C.ok, "bold"); }
  else tell(p.id, `💸 Không trúng, mất ${amount.toLocaleString()} xu.`, C.err);
  Store.touch();
}

